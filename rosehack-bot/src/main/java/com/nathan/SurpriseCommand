package com.nathan;

import net.dv8tion.jda.api.EmbedBuilder;
import net.dv8tion.jda.api.events.interaction.command.SlashCommandInteractionEvent;
import org.jetbrains.annotations.NotNull;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.Random;

public class SurpriseCommand {
    public static void surpriseMe(@NotNull SlashCommandInteractionEvent event) {
        HashMap<Long, String[]> hs = InfoHashMap.infoHashMap;
        Random generator = new Random();
        ArrayList<String[]> arr = new ArrayList<>(hs.values());
        String[] chosenProfile = arr.get(generator.nextInt(arr.size()));

        EmbedBuilder builder = new EmbedBuilder();
        builder.addField("Here is a random profile.  Let's make new connections!",
                "Name: " + chosenProfile[0]
                        + "\n" + "Age: " + chosenProfile[1]
                        + "\n" + "Status: " + chosenProfile[2]
                        + "\n" + "Contact Info: " + chosenProfile[3]
                        + "\n" + "Description: " + chosenProfile[4], false);
        event.reply("")
                .addEmbeds(builder.build())
                .queue();
    }
}
