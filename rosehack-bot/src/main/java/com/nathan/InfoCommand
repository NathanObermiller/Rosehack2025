package com.nathan;

import net.dv8tion.jda.api.EmbedBuilder;
import net.dv8tion.jda.api.events.interaction.command.SlashCommandInteractionEvent;
import net.dv8tion.jda.api.interactions.commands.OptionMapping;
import net.dv8tion.jda.api.interactions.components.ActionRow;
import net.dv8tion.jda.api.interactions.components.text.TextInput;
import net.dv8tion.jda.api.interactions.components.text.TextInputStyle;
import net.dv8tion.jda.api.interactions.modals.Modal;
import org.jetbrains.annotations.NotNull;

import java.util.HashMap;
import java.util.Map;
import java.util.Scanner;

public class InfoCommand {
    public static void newInfo(@NotNull SlashCommandInteractionEvent event, boolean status) {
        TextInput name = TextInput.create("name-field", "Name", TextInputStyle.SHORT)
                .setRequired(true)
                .setMinLength(1)
                .setMaxLength(50)
                .build();

        TextInput age = TextInput.create("age-field", "Age", TextInputStyle.SHORT)
                .setRequired(true)
                .setMinLength(1)
                .setMaxLength(3)
                .build();

        TextInput contact = TextInput.create("contact-field", "Contact information", TextInputStyle.SHORT)
                .setRequired(true)
                .setMinLength(1)
                .build();

        TextInput description = TextInput.create("description-field", "Write a short description!", TextInputStyle.PARAGRAPH)
                .setRequired(true)
                .build();

        Modal infoModal = Modal.create("info-modal", "Create your profile")
                .addActionRow(name)
                .addActionRow(age)
                .addActionRow(contact)
                .addActionRow(description)
                .build();

        event.replyModal(infoModal)
                .queue();
    }

    public static void infoSearch(SlashCommandInteractionEvent event) {
        OptionMapping queryValue = event.getOption("query");
        String queryString = queryValue.getAsString();
        Scanner sc = new Scanner(queryString);
        HashMap<Long, String[]> filteredMap = new HashMap<>(InfoHashMap.infoHashMap);
        while (sc.hasNext()) {
            String nextString = sc.next();
            System.out.println(nextString);
            filteredMap = query(filteredMap, nextString);
        }

        if (filteredMap.isEmpty()) {
            event.reply("Your search is too narrow. Try to broaden your search!")
                .queue();
            return;
        }
        EmbedBuilder builder = new EmbedBuilder();
        int count = 1;
        for (Map.Entry<Long, String[]> user : filteredMap.entrySet()) {
            builder.addField(user.getValue()[0], "Age: " + user.getValue()[1]
                    + "\n" + "Contact Info: " + user.getValue()[2]
                    + "\n" + "Description: " + user.getValue()[3], false);
            count++;
            if (count > 3) {
                break;
            }
        }
        String message = "";
        if (count == 2) {
            message = "I've found someone you might like!";
        }
        else {
            message = "I've found some people you might like!";
        }
        event.reply(message)
                .addEmbeds(builder.build())
                .queue();
    }

    public static HashMap<Long, String[]> query(HashMap<Long, String[]> hs, String queryString) {
        HashMap<Long, String[]> hashMap1 = new HashMap<>();
        for (Map.Entry<Long, String[]> user: hs.entrySet())
        {
            if (user.getValue()[3].toLowerCase().contains(queryString.toLowerCase()))
                {
                    hashMap1.put(user.getKey(), user.getValue());
                }
        }
        return hashMap1;
    }
}
