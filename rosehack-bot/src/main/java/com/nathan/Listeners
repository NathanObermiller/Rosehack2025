package com.nathan;

import net.dv8tion.jda.api.JDA;
import net.dv8tion.jda.api.entities.Guild;
import net.dv8tion.jda.api.entities.channel.concrete.TextChannel;
import net.dv8tion.jda.api.events.interaction.ModalInteractionEvent;
import net.dv8tion.jda.api.events.interaction.command.SlashCommandInteractionEvent;
import net.dv8tion.jda.api.events.session.ReadyEvent;
import net.dv8tion.jda.api.hooks.ListenerAdapter;
import net.dv8tion.jda.api.interactions.commands.OptionMapping;
import net.dv8tion.jda.api.interactions.commands.OptionType;
import net.dv8tion.jda.api.interactions.commands.build.OptionData;
import net.dv8tion.jda.api.interactions.modals.ModalMapping;
import org.jetbrains.annotations.NotNull;
import org.w3c.dom.Text;

import java.util.HashMap;

public class Listeners extends ListenerAdapter {
    @Override
    public void onReady (@NotNull ReadyEvent event) {
        for (Guild guild : event.getJDA().getGuilds()) {
            for (TextChannel channel : guild.getTextChannels()) {
                channel.sendMessage("I am now online.").queue();
            }
        }
        JDA jda = event.getJDA();
        jda.upsertCommand("new-info", "Upload your info to the bot!")
                .addOptions(new OptionData(OptionType.BOOLEAN, "status", "Are you a mentor? [mentor - true / mentee - false]", true))
                .queue();

        jda.upsertCommand("search", "Search for a user that fits your criteria")
                .addOptions(new OptionData(OptionType.STRING, "query", "Specify your search with a few key words separated by spaces", true))
                .queue();
    }

    @Override
    public void onSlashCommandInteraction (@NotNull SlashCommandInteractionEvent event) {
        if (event.getName().equals("new-info")) {
            OptionMapping mentorStatus = event.getOption("status");
            boolean status = mentorStatus.getAsBoolean();
            InfoCommand.newInfo(event, status);
        }
        else if (event.getName().equals("search")) {
            InfoCommand.infoSearch(event);
        }
    }

    @Override
    public void onModalInteraction (@NotNull ModalInteractionEvent event) {
        if (event.getModalId().equals("info-modal")) {
            ModalMapping nameValue = event.getValue("name-field");
            ModalMapping ageValue = event.getValue("age-field");
            ModalMapping contactInfoValue = event.getValue("contact-field");
            ModalMapping descriptionValue = event.getValue("description-field");

            String name = nameValue.getAsString();
            String age = ageValue.getAsString();
            String description = descriptionValue.getAsString();
            String contact = contactInfoValue.getAsString();

            HashMap<Long, String[]> hs = InfoHashMap.infoHashMap;
            String[] userInfoArray = {name, age, contact, description};
            hs.put(Long.parseLong(event.getUser().getId()), userInfoArray);

            event.reply("Data successfully added. Thank you!").queue();
        }
    }
}
