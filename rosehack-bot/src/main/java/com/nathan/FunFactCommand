package com.nathan;

import net.dv8tion.jda.api.events.interaction.command.SlashCommandInteractionEvent;
import org.jetbrains.annotations.NotNull;

import java.util.Random;

public class FunFactCommand {
    public static void funFactCommand(@NotNull SlashCommandInteractionEvent event) {
        Random rand = new Random();
        String[] facts = FunFacts.funFacts;
        int randInt = rand.nextInt(facts.length);
        
        String chosenFact = facts[randInt];

        event.reply("Here's a fun fact:\n" + chosenFact).queue();
    }
}
